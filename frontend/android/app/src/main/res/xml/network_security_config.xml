<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ (API 28+) blocks plaintext HTTP by default. This backend is served over plain
  HTTP during development (no TLS cert for a local/LAN dev server), so without this config
  every request would fail at the OS network layer with a connection error before it ever
  reached Dio — regardless of whether the configured IP/port was otherwise correct.

  Scoped to only the specific dev hosts the app talks to (LAN IP, Android emulator alias,
  localhost) rather than a blanket app-wide allowance, so this stays a deliberate dev-only
  allowance rather than a general security downgrade.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.6</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
