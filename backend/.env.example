APP_ENV=development
PORT=8080

# PostgreSQL — format: postgres://user:password@host:5432/dbname?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onebharat?sslmode=disable

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Razorpay (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Business rules
PLATFORM_FEE_PERCENT=2.0
AUTO_RELEASE_DAYS=7

# Storage abstraction — "local" (default) needs zero setup and works immediately in dev.
# Switch to "s3" (and fill in the AWS_* values below) when deploying — no code change needed.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./storage/uploads
# Normally left blank — derived automatically from the request's Host header so local
# storage works over LAN (phone -> dev PC) without manual IP configuration. Set explicitly
# only if running local storage behind a reverse proxy that needs a fixed public URL.
STORAGE_PUBLIC_BASE_URL=

# AWS S3 (for KYC docs, POD images) — only used when STORAGE_PROVIDER=s3
AWS_S3_BUCKET=onebharat-uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional — only set these for local dev against an S3-compatible store like MinIO.
# Leave blank to use real AWS S3.
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_URL=

# Groq (OpenAI-compatible) — used for AI Product Search (semantic HS code matching)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# One-time admin bootstrap (no admin dashboard/registration route exists — this is the
# only way to create the ops account that reviews KYC). Set once, restart, then blank these out.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Platform Admin

# Firebase push notifications — FIREBASE_PROJECT_ID comes from google-services.json (project_info.project_id).
# FIREBASE_SERVICE_ACCOUNT_FILE is a SEPARATE server-side credential: Firebase Console ->
# Project Settings -> Service Accounts -> Generate new private key. Leave blank to disable sending.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=
